{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Blanquette",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/blanquette",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "La Totale (Make)", // Relance le Makefile avant de déboguer
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
